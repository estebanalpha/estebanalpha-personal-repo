#!/data/data/com.termux/files/usr/bin/bash
#
# shizuku-pair: guided helper for the Android 11+ wireless flow.
#
# Wireless debugging uses TLS with a one-time pairing code and a TLS port
# that changes whenever the feature is switched on. Pairing credentials
# persist, so after the first pairing adb-connect needs no input. This
# command covers what cannot be automated:
#   1. Try the automatic path first (last known port, then the port shown
#      by a notification of the configured app). Success ends the run.
#   2. If the device is not paired yet, pair it with the pairing port and
#      the 6-digit code shown in Settings (needed once).
#   3. If no port could be found, ask for it (main Wireless debugging
#      screen, not the pairing dialog).
# On success adbd is pinned to 127.0.0.1:5555 and the serial is saved for
# adb-connect and shizuku-watchdog.

. /data/data/com.termux/files/usr/lib/shizuku-semi-auto/common.sh
sa_load_config
sa_log_init "$SA_TMP/shizuku-pair.log"

SDK=$(sa_sdk)
if [ "$SDK" -lt 30 ]; then
    sa_say "Esta herramienta es solo para Android 11+ (SDK $SDK). En tu versión usa el flujo por cable: 'adb tcpip 5555' desde otro equipo." \
           "This helper is for Android 11+ only (SDK $SDK). On your version use the cable flow: 'adb tcpip 5555' from another device."
    exit 1
fi

ask() {
    # ask VAR "es" "en" -> reads one line into VAR (empty on EOF)
    local __v
    printf '%s ' "$(sa_t "$2" "$3")"
    read -r __v || __v=""
    printf -v "$1" '%s' "$__v"
}

finish_ok() {
    sa_say "" ""
    if [ "$SA_PINNED" = 1 ]; then
        sa_say "Listo: adbd fijado en $SA_FIXED_SERIAL y estado guardado." \
               "Done: adbd pinned to $SA_FIXED_SERIAL and state saved."
    else
        sa_say "Conectado por TLS en $SA_SERIAL_USED (no se pudo fijar el puerto 5555); estado guardado." \
               "Connected over TLS at $SA_SERIAL_USED (could not pin port 5555); state saved."
    fi
    sa_say "El watchdog toma el estado en unos segundos y mantiene Shizuku activo." \
           "The watchdog picks the state up within seconds and keeps Shizuku alive."
    sa_say "Emparejado una vez, adb-connect se reconecta solo tras cada reinicio mientras la depuración inalámbrica esté activa y su puerto se pueda leer." \
           "Once paired, adb-connect reconnects by itself after each reboot as long as Wireless debugging is on and its port can be read."
    sa_logt "shizuku-pair finalizado ($SA_SERIAL_USED)." "shizuku-pair finished ($SA_SERIAL_USED)."
}

timeout 8 "$SA_ADB" start-server >/dev/null 2>&1

sa_say "" ""
sa_say "=== shizuku-pair (Android 11+) ===" "=== shizuku-pair (Android 11+) ==="
sa_say "Mantén la depuración inalámbrica ACTIVADA durante todo el proceso." \
       "Keep Wireless debugging ON during the whole process."
sa_say "" ""
sa_say "Buscando el puerto (último puerto conocido y notificaciones)..." \
       "Looking for the port (last known port and notifications)..."

if sa_wireless_connect; then
    sa_logt "Conexión automática por el puerto $SA_WPORT." "Automatic connection through port $SA_WPORT."
    finish_ok
    exit 0
fi

if [ "$SA_WREASON" = connect_failed ]; then
    sa_say "Se encontró el puerto $SA_WPORT pero no fue posible conectar: es probable que este equipo aún no esté emparejado." \
           "Found port $SA_WPORT but could not connect: this device is probably not paired yet."
else
    sa_say "No se encontró el puerto automáticamente." "The port was not found automatically."
fi

sa_say "" ""
ask FIRST "¿Emparejar este equipo ahora (solo hace falta una vez)? [s/N]" \
          "Pair this device now (only needed once)? [y/N]"
case "$FIRST" in
    s|S|y|Y)
        sa_say "Ajustes > Opciones de desarrollador > Depuración inalámbrica >" \
               "Settings > Developer options > Wireless debugging >"
        sa_say "'Vincular dispositivo con código de vinculación' y DEJA el diálogo abierto." \
               "'Pair device with pairing code' and LEAVE the dialog open."
        ask PPORT "Puerto del diálogo (p. ej. 34923):" "Port from the dialog (e.g. 34923):"
        ask CODE  "Código de 6 dígitos:" "6-digit code:"
        OUT=$(printf '%s\n' "$CODE" | timeout 20 "$SA_ADB" pair "127.0.0.1:$PPORT" 2>&1)
        printf '%s\n' "$OUT"
        if ! printf '%s' "$OUT" | grep -q "Successfully paired"; then
            sa_say "El emparejamiento automático falló; prueba de forma interactiva (escribe el código cuando lo pida):" \
                   "Automatic pairing failed; trying interactively (type the code when asked):"
            timeout 30 "$SA_ADB" pair "127.0.0.1:$PPORT" || true
        fi
        sa_logt "Emparejamiento intentado en el puerto $PPORT." "Pairing attempted on port $PPORT."
        sa_say "Reintentando la conexión automática..." "Retrying the automatic connection..."
        if sa_wireless_connect; then
            finish_ok
            exit 0
        fi
        ;;
esac

sa_say "" ""
sa_say "En la pantalla PRINCIPAL de Depuración inalámbrica (no en el diálogo de vinculación) se muestra IP:PUERTO." \
       "The MAIN Wireless debugging screen (not the pairing dialog) shows IP:PORT."
ask PORT "Puerto (p. ej. 46733):" "Port (e.g. 46733):"
case "$PORT" in ''|*[!0-9]*)
    sa_say "Puerto no válido." "Invalid port."
    exit 1
    ;;
esac

if ! sa_try_port "$PORT"; then
    sa_say "ERROR: no se pudo conectar al puerto $PORT. ¿Es el de la pantalla principal y el equipo está emparejado?" \
           "ERROR: could not connect to port $PORT. Is it the main-screen one, and is the device paired?"
    sa_logt "Conexión manual fallida en el puerto $PORT." "Manual connection failed on port $PORT."
    exit 1
fi
sa_say "Conectado por TLS en 127.0.0.1:$PORT. Fijando adbd al puerto 5555..." \
       "Connected over TLS at 127.0.0.1:$PORT. Pinning adbd to port 5555..."
sa_pin_save "$PORT"
finish_ok
