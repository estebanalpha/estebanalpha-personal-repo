#!/data/data/com.termux/files/usr/bin/bash

# EN: Binaries in $PREFIX/bin are removed by dpkg itself. Here we only
# kill running daemons, remove the Termux:Boot launchers from $HOME and
# clean volatile state. Logs in ~/.local/tmp are kept on purpose for
# post-mortem debugging.
# ES: Los binarios de $PREFIX/bin los borra dpkg solo. Acá solo matamos
# los daemons corriendo, quitamos los launchers de Termux:Boot de $HOME
# y limpiamos el estado volatil. Los logs de ~/.local/tmp se conservan
# a proposito para depurar despues de desinstalar.

PREFIX="/data/data/com.termux/files/usr"
DEST_HOME="/data/data/com.termux/files/home"

pkill -f "$PREFIX/bin/adb-connect" 2>/dev/null || true
pkill -f "$PREFIX/bin/shizuku-watchdog" 2>/dev/null || true

rm -f "$DEST_HOME/.termux/boot/adb-connect" "$DEST_HOME/.termux/boot/shizuku-watchdog"

# Estado volátil: serial loopback + método de arranque de Shizuku
# cacheado. Se regenera solo en el próximo ciclo.
rm -f "$DEST_HOME/.local/tmp/adb-serial.txt" "$DEST_HOME/.local/tmp/shizuku-method.txt"

exit 0
