#!/data/data/com.termux/files/usr/bin/bash

# Binaries in $PREFIX/bin and the private library are removed by dpkg
# itself. Here the running daemons are stopped, the Termux:Boot launchers
# are removed from $HOME and volatile state is cleaned. The user's
# configuration (~/.config/shizuku-semi-auto) and the logs in
# ~/.local/tmp are kept on purpose.

PREFIX="/data/data/com.termux/files/usr"
DEST_HOME="/data/data/com.termux/files/home"

pkill -f "$PREFIX/bin/adb-connect" 2>/dev/null || true
pkill -f "$PREFIX/bin/shizuku-watchdog" 2>/dev/null || true

rm -f "$DEST_HOME/.termux/boot/adb-connect" "$DEST_HOME/.termux/boot/shizuku-watchdog"

# Volatile state: loopback serial, cached Shizuku start method, last
# wireless port and instance locks. All of it is regenerated on demand.
rm -f "$DEST_HOME/.local/tmp/adb-serial.txt" \
      "$DEST_HOME/.local/tmp/shizuku-method.txt" \
      "$DEST_HOME/.local/tmp/wireless-port.txt"
rm -rf "$DEST_HOME/.local/tmp/adb-connect.lock" \
       "$DEST_HOME/.local/tmp/shizuku-watchdog.lock"

exit 0
