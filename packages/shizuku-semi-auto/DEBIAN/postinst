#!/data/data/com.termux/files/usr/bin/bash
set -e

SRC="/data/data/com.termux/files/usr/opt/shizuku-semi-auto"
DEST_HOME="/data/data/com.termux/files/home"

mkdir -p "$DEST_HOME/.local/bin" "$DEST_HOME/.local/tmp" "$DEST_HOME/.termux/boot"

cp "$SRC/bin/adb-connect"       "$DEST_HOME/.local/bin/adb-connect"
cp "$SRC/bin/shizuku-watchdog"  "$DEST_HOME/.local/bin/shizuku-watchdog"
cp "$SRC/bin/shizuku-pair"      "$DEST_HOME/.local/bin/shizuku-pair"
cp "$SRC/boot/adb-connect"      "$DEST_HOME/.termux/boot/adb-connect"
cp "$SRC/boot/shizuku-watchdog" "$DEST_HOME/.termux/boot/shizuku-watchdog"

chmod +x "$DEST_HOME/.local/bin/adb-connect" "$DEST_HOME/.local/bin/shizuku-watchdog" \
         "$DEST_HOME/.local/bin/shizuku-pair" \
         "$DEST_HOME/.termux/boot/adb-connect" "$DEST_HOME/.termux/boot/shizuku-watchdog"

cat <<'MSG'

== shizuku-semi-auto installed / instalado ==

EN - Before rebooting, confirm manually:
1) Termux:Boot installed and OPENED at least once. IMPORTANT: it must
   come from the SAME source as your main Termux app (GitHub or
   F-Droid, not mixed) - Android refuses to run apps that share
   Termux's signature scope if they are signed with different keys.
   Check your current app's source with: echo $TERMUX_APK_RELEASE
2) Shizuku app installed; open its "ADB" tab once so it generates
   start.sh (on 13.6+ the watchdog uses libshizuku.so instead).
3) Optional: pkg install -y termux-api + the Termux:API app (same
   source as above), for the notification when the watchdog
   reactivates Shizuku.
4) Optional: add $HOME/.local/bin to PATH in your .bashrc.

FLOWS / FLUJOS:
- Android 10 and below / y anteriores: after reboot, connect a cable
  (or a second device) and run 'adb tcpip 5555' from the other side.
  The USB-mode priming runs automatically on these versions.
- Android 11 and above / y superiores: after reboot, run
  'shizuku-pair' and type the port shown in Settings > Wireless
  debugging (pairing code only the first time).

Reboot, then test. Logs: ~/.local/tmp/*.log
MSG
